---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Fundar Venezuela - Fundación para el desarrollo',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget / Inicio ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Donar ahora',
        href: '#donar',
        icon: 'tabler:heart',
      },
      { text: 'Conoce más', href: '#quienes-somos' },
    ]}
    image={{ src: '/logo.png', alt: 'Fundar Venezuela Logo' }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white highlight">FUNDAR</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Fundación Para dar Ayuda y Restaurar.</span><br />
        Instituto de Altos Estudios en Derechos DDHH.</span>
      <span class="block mb-1 font-bold text-blue-600 mt-4 italic">"Cuando todos sean una palabra. Tú se Ejemplo."</span>
    </Fragment>
  </Hero>

  <!-- Quienes Somos Widget **************** -->

  <Content
    id="quienes-somos"
    isReversed
    tagline="Sobre Nosotros"
    title="Quiénes Somos"
    items={[
      {
        title: 'Nuestra Misión',
        description:
          'Promover el desarrollo integral de las comunidades vulnerables a través de programas educativos y de apoyo social.',
      },
      {
        title: 'Nuestra Visión',
        description:
          'Ser una fundación líder en Venezuela, reconocida por su impacto positivo y duradero en la sociedad.',
      },
      {
        title: 'Nuestros Valores',
        description:
          'Solidaridad, Transparencia, Compromiso, y Respeto por la dignidad humana.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1529390079861-591de354faf5?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Equipo Fundar Venezuela',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Construyendo oportunidades</h3>
      Trabajamos incansablemente para brindar herramientas que permitan a las personas forjar un mejor futuro.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Galería Widget *************** -->

  <Features2
    id="galeria"
    title="Galería"
    subtitle="Un vistazo a nuestras actividades y el impacto que generamos en la comunidad."
    tagline="Nuestro Impacto"
    items={[
      {
        title: 'Entrega de útiles',
        description: 'Apoyando la educación desde temprana edad.',
        icon: 'tabler:photo',
      },
      {
        title: 'Talleres comunitarios',
        description: 'Fomentando el aprendizaje y la integración.',
        icon: 'tabler:photo',
      },
      {
        title: 'Jornadas de salud',
        description: 'Llevando bienestar a quienes más lo necesitan.',
        icon: 'tabler:photo',
      },
      {
        title: 'Actividades recreativas',
        description: 'Promoviendo el esparcimiento sano.',
        icon: 'tabler:photo',
      },
      {
        title: 'Capacitación laboral',
        description: 'Brindando herramientas para el trabajo.',
        icon: 'tabler:photo',
      },
      {
        title: 'Eventos benéficos',
        description: 'Recaudando fondos para nuestras causas.',
        icon: 'tabler:photo',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Cursos Widget ****************** -->

  <Steps
    id="cursos"
    title="Nuestros Cursos"
    items={[
      {
        title: 'Curso de Liderazgo Comunitario <br /> <span class="font-normal">Aprende a gestionar proyectos y liderar iniciativas en tu comunidad.</span>',
        icon: 'tabler:users',
      },
      {
        title: 'Taller de Emprendimiento <br /> <span class="font-normal">Herramientas prácticas para iniciar tu propio negocio.</span>',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Formación en Oficios <br /> <span class="font-normal">Capacitación técnica en áreas de alta demanda laboral.</span>',
        icon: 'tabler:tools',
      },
      {
        title: '¡Inscríbete hoy!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1524178232363-1fb2b075b655?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Cursos Fundar Venezuela',
    }}
  />

  <!-- BlogLatestPosts Widget ******* -->

  <BlogLatestPosts
    title="Blog y Noticias"
    information={`Mantente informado sobre nuestras últimas actividades, logros e historias inspiradoras. Descubre cómo tu apoyo está haciendo la diferencia.`}
  />

  <!-- Donar Widget ******************* -->

  <Content
    id="donar"
    isReversed
    tagline="Apóyanos"
    title="Haz tu Donación"
    items={[
      {
        title: 'Transferencia Bancaria',
        description: 'Banco: Banco de Venezuela<br/>Cuenta: 0102-xxxx-xxxx-xxxx-xxxx<br/>Titular: Fundación Para dar Ayuda y Restaurar<br/>RIF: J-40293628-1<br/>M.P.P.E: R-01320318',
        icon: 'tabler:building-bank',
      },
      {
        title: 'Pago Móvil',
        description: 'Banco: Banco de Venezuela (0102)<br/>Teléfono: 0414-xxxxxxx<br/>RIF: J-40293628-1',
        icon: 'tabler:device-mobile',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1532629345422-7515f3d16bb6?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Donaciones',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Tu aporte cambia vidas</h3>
      Con tu contribución, podemos seguir desarrollando programas que benefician a cientos de personas. Cada donativo, sin importar el monto, hace una gran diferencia.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

</Layout>
